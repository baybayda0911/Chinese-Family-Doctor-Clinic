{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baybayda0911.github.io/Chinese-Family-Doctor-Clinic/contracts/context.schema.json",
  "title": "context",
  "type": "object",
  "properties": {
    "synthetic": {
      "type": "boolean"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,95}$"
    },
    "member_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,95}$"
    },
    "snapshot_revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_scope": {
      "enum": [
        "symptom",
        "report",
        "daily_health"
      ]
    },
    "grant_ref": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,95}$"
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "general",
          "mental_health",
          "reproductive"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "clinical-entry.schema.json"
      }
    }
  },
  "required": [
    "synthetic",
    "context_id",
    "member_id",
    "snapshot_revision",
    "task_scope",
    "grant_ref",
    "categories",
    "records"
  ],
  "additionalProperties": false
}
